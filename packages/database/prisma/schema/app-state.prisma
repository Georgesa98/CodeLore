// ─────────────────────────────────────────
// APP STATE
// Living documentation sections
// ─────────────────────────────────────────
model AppState {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  section   String   // e.g. "architecture" | "tech_stack" | "auth_flow" | "database" | "current_focus"
  content   String   // markdown
  updatedAt DateTime @updatedAt
  updatedBy String?  // session id that last updated this

  @@unique([projectId, section])
}
